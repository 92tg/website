# ============================================
# FileVault — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.

# Server
PORT=3000
NODE_ENV=production

# Admin credentials (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# JWT secret for session tokens (generate a strong random string)
JWT_SECRET=replace-with-a-long-random-secret-string

# Storage mode: "local" or "webhook"
STORAGE_MODE=local

# Webhook URL (only used when STORAGE_MODE=webhook)
# On a cloud host (e.g. Render) Discord may block the shared IP with
# Error 1015. If so, deploy the Cloudflare Worker in ./worker and point
# this at the Worker URL instead of the Discord URL. See worker/README.md.
WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Shared secret for the Cloudflare Worker relay (optional). Must match the
# RELAY_SECRET set on the Worker. Leave blank when posting straight to Discord.
RELAY_SECRET=

# Max file size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880

# Upload rate limit: max uploads per window per IP
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MINUTES=15
